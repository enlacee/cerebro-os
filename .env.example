# ── Cerebro OS (app) · lo de Docker va en ../.env ──────────
CEREBRO_BUSINESS_NAME="Aníbal Linux"
CEREBRO_TIMEZONE=America/Lima
CEREBRO_KNOWLEDGE_EXCLUDE=oportunidades.md

# IA (Prism): gemini | groq | openrouter | deepseek | openai | anthropic | ollama
CEREBRO_LLM_PROVIDER=gemini
CEREBRO_LLM_MODEL=gemini-3.6-flash
# Si el modelo principal falla (saturado, cuota), se reintenta con este.
CEREBRO_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
CEREBRO_LLM_MAX_TOKENS=2048
GEMINI_API_KEY=

# Dominios que pueden usar el widget, separados por coma. "*" solo en desarrollo.
CEREBRO_ALLOWED_ORIGINS=*
CEREBRO_CHAT_PER_MINUTE=10
CEREBRO_CHAT_PER_DAY=100
CEREBRO_CALLS_PER_DAY=3

# Avisos por Telegram ("que me llame"). Crea el bot con @BotFather y corre: php artisan telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


APP_NAME="Cerebro OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
