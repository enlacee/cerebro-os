# ── Docker de esta instancia (lo de la app va en laravel/.env) ──
# Nombre de los contenedores: usa el de la carpeta (ej. chat.anibalcopitan.com).
NAME=chat.anibalcopitan.com

# ── Solo en el VPS ──
# Dominio público (registro A → IP del VPS) y email para el certificado HTTPS.
DOMAIN=chat.anibalcopitan.com
EMAIL=
# Dueño de los archivos en el servidor (id -u / id -g).
UID=1000
GID=1000

# ── Solo en tu PC ──
APP_PORT=8000
# Carpeta del vault de Obsidian (deploy.sh la sube al VPS sin los archivos internos).
KNOWLEDGE_PATH=./knowledge
# ./deploy.sh: usuario@IP del VPS y carpeta raíz allá.
DEPLOY_HOST=
DEPLOY_DIR=cerebro-os
