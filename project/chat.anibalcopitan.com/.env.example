# ── Docker de esta instancia (lo de la app va en laravel/.env) ──
# Nombre de los contenedores (único por instancia si comparten servidor).
COMPOSE_PROJECT_NAME=cerebro-anibalcopitan

# Local: puerto y ":80". Producción: tu dominio → HTTPS automático.
APP_PORT=8000
SERVER_NAME=:80

# Local: carpeta del vault de Obsidian. En el VPS no se usa (deploy.sh lo sube a ./knowledge).
KNOWLEDGE_PATH=./knowledge

# Debe coincidir con el usuario dueño de los archivos (id -u / id -g).
UID=1000
GID=1000

# Solo en tu PC, para ./deploy.sh: usuario@IP del VPS.
DEPLOY_HOST=
DEPLOY_DIR=cerebro-os
