# ── Producción (VPS) ──────────────────────────────────────
# Copia a laravel/.env en el servidor y completa los vacíos. Nunca lo subas a git.
# (El dominio, SERVER_NAME, va en el .env de Docker de la instancia.)
APP_URL=https://chat.anibalcopitan.com
APP_NAME="Cerebro OS"
APP_ENV=production
APP_DEBUG=false
# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

# Solo tu web puede usar el widget (separa con coma si son varias).
CEREBRO_ALLOWED_ORIGINS=https://anibalcopitan.com,https://www.anibalcopitan.com
# Detrás de nginx-proxy: "docker". Si el dominio pasa por Cloudflare (nube naranja): "docker,cloudflare".
CEREBRO_TRUSTED_PROXIES=docker
CEREBRO_CHAT_PER_MINUTE=10
CEREBRO_CHAT_PER_DAY=100
# Tope diario de toda la instancia (todas las IPs juntas)
CEREBRO_CHAT_GLOBAL_PER_DAY=1000
CEREBRO_CALLS_PER_DAY=3
CEREBRO_RETENTION_CALLS_DAYS=90
CEREBRO_RETENTION_CONVERSATIONS_DAYS=180
CEREBRO_BACKUP_KEEP=14

# ── Chat: lo que cambia de un negocio a otro ───────────────
CEREBRO_BUSINESS_NAME="Aníbal Linux"
# Quien atiende: "Hablar con Aníbal", "Que Aníbal me llame". Vacío = el nombre del negocio.
CEREBRO_OWNER_NAME="Aníbal"
# Solo dígitos, con código de país.
CEREBRO_WHATSAPP=51970142637
CEREBRO_GREETING="¡Hola! 👋 Soy el asistente de Aníbal Linux. ¿Qué necesitas?"
CEREBRO_COLOR_ACCENT="#1a73e8"
CEREBRO_TIMEZONE=America/Lima

# Llamadas: días 1-5 = lunes a viernes (o "1,3,5"); horas en la zona de CEREBRO_TIMEZONE.
CEREBRO_CALL_DAYS=1-5
CEREBRO_CALL_HOURS="11:00-12:00,15:00-16:00"
CEREBRO_CALL_TIMEZONE_LABEL="hora Perú"
CEREBRO_CALL_COUNTRY_CODE="+51"
CEREBRO_CALL_INTRO='Llamada rápida por WhatsApp (3 min) para conocerte y saber de tu proyecto. **No es asesoría**: lo técnico lo vemos en la Consulta Técnica ($20).'

# Chips (máx. 8): "texto del botón | mensaje que se envía al asistente".
CEREBRO_TOPIC_1="📱 Crear mi app Android | Quiero crear mi propia app Android"
CEREBRO_TOPIC_2="🚀 Publicar mi app Android/iOS | Quiero publicar mi app en Play Store o App Store"
CEREBRO_TOPIC_3="🤝 Asesoría / Acompañamiento | Quiero una asesoría o acompañamiento"
CEREBRO_TOPIC_4="🐧 Aprender Linux | Quiero aprender Linux"
CEREBRO_TOPIC_5="🖥️ Mi servidor en casa / VPS | Quiero crear mi servidor en casa o VPS"
CEREBRO_TOPIC_6="⭐ Ver tus apps publicadas | Quiero ver tus apps publicadas"

CEREBRO_LLM_PROVIDER=gemini
CEREBRO_LLM_MODEL=gemini-3.6-flash
CEREBRO_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
CEREBRO_LLM_MAX_TOKENS=800
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
