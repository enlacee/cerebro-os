# ── Chat: lo que cambia de un negocio a otro ───────────────
CEREBRO_BUSINESS_NAME="Aníbal Linux"
# Quien atiende: "Hablar con Aníbal", "Que Aníbal me llame". Vacío = el nombre del negocio.
CEREBRO_OWNER_NAME="Aníbal"
# Solo dígitos, con código de país.
CEREBRO_WHATSAPP=51970142637
CEREBRO_GREETING="¡Hola! 👋 Soy el asistente de Aníbal Linux. ¿Qué necesitas?"
CEREBRO_COLOR_ACCENT="#1a73e8"
CEREBRO_TIMEZONE=America/Lima

# Llamadas: días 1-5 = lunes a viernes (o "1,3,5"); horas en la zona de CEREBRO_TIMEZONE.
CEREBRO_CALL_DAYS=1-5
CEREBRO_CALL_HOURS="11:00-12:00,15:00-16:00"
CEREBRO_CALL_TIMEZONE_LABEL="hora Perú"
CEREBRO_CALL_COUNTRY_CODE="+51"
CEREBRO_CALL_INTRO='Llamada rápida por WhatsApp (3 min) para conocerte y saber de tu proyecto. **No es asesoría**: lo técnico lo vemos en la Consulta Técnica ($20).'

# Chips (máx. 8): "texto del botón | mensaje que se envía | respuesta escrita (opcional)".
# La respuesta es un .md de knowledge/ (ej. respuestas/publicar-app.md): sale al instante, sin IA ni tokens.
# Sin respuesta escrita, el mensaje va a la IA.
CEREBRO_TOPICS_TITLE="Lo más buscado"
CEREBRO_TOPIC_1="📱 Crear mi app Android | Quiero crear mi propia app Android | respuestas/crear-app-android.md"
CEREBRO_TOPIC_2="🚀 Publicar mi app Android/iOS | Quiero publicar mi app en Play Store o App Store | respuestas/publicar-app.md"
CEREBRO_TOPIC_3="🤝 Asesoría / Acompañamiento | Quiero una asesoría o acompañamiento | respuestas/asesoria.md"
CEREBRO_TOPIC_4="🐧 Aprender Linux | Quiero aprender Linux | respuestas/aprender-linux.md"
CEREBRO_TOPIC_5="🖥️ Mi servidor en casa / VPS | Quiero crear mi servidor en casa o VPS | respuestas/servidor-vps.md"
CEREBRO_TOPIC_6="⭐ Ver tus apps publicadas | Quiero ver tus apps publicadas | respuestas/apps-publicadas.md"

# Prueba social y redes al pie de la bienvenida (vacío = no se muestra).
CEREBRO_RATING="4.9"
CEREBRO_RATING_SOURCE=Google
CEREBRO_RATING_URL=https://maps.app.goo.gl/JRrBrmTmXPokXJyt6
# Link del dueño al pie: "tipo|url|texto". Mejor uno solo. Tipos con ícono: blog, web, youtube, tiktok, facebook, instagram, linkedin.
CEREBRO_LINKS="blog|https://blog.anibalcopitan.com/|Tutoriales y proyectos en mi blog"

# ── Cerebro OS (app) · lo de Docker va en ../.env ──────────

# IA (Prism): gemini | groq | openrouter | deepseek | openai | anthropic | ollama
CEREBRO_LLM_PROVIDER=gemini
CEREBRO_LLM_MODEL=gemini-3.6-flash
# Si el modelo principal falla (saturado, cuota), se reintenta con este.
CEREBRO_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Tope de la respuesta; incluye lo que el modelo "piensa". Con menos de ~2000 se cortan respuestas.
CEREBRO_LLM_MAX_TOKENS=3000
GEMINI_API_KEY=

# Dominios que pueden usar el widget, separados por coma. "*" solo en desarrollo.
CEREBRO_ALLOWED_ORIGINS=*
CEREBRO_CHAT_PER_MINUTE=10
CEREBRO_CHAT_PER_DAY=100
# Tope diario de toda la instancia (todas las IPs juntas)
CEREBRO_CHAT_GLOBAL_PER_DAY=1000
CEREBRO_CALLS_PER_DAY=3

# Avisos por Telegram ("que me llame"). Crea el bot con @BotFather y corre: php artisan telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


APP_NAME="Cerebro OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
