# ── Producción (VPS) ──────────────────────────────────────
# Copia a laravel/.env en el servidor y completa los vacíos. Nunca lo subas a git.
# (El dominio, SERVER_NAME, va en el .env de Docker de la instancia.)
APP_URL=https://chat.anibalcopitan.com
APP_NAME="Cerebro OS"
APP_ENV=production
APP_DEBUG=false
# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

# Solo tu web puede usar el widget (separa con coma si son varias).
CEREBRO_ALLOWED_ORIGINS=https://anibalcopitan.com,https://www.anibalcopitan.com
# Detrás de nginx-proxy: "docker". Si el dominio pasa por Cloudflare (nube naranja): "docker,cloudflare".
CEREBRO_TRUSTED_PROXIES=docker
CEREBRO_BUSINESS_NAME="Aníbal Linux"
CEREBRO_TIMEZONE=America/Lima
CEREBRO_CHAT_PER_MINUTE=10
CEREBRO_CHAT_PER_DAY=100
CEREBRO_CALLS_PER_DAY=3
CEREBRO_RETENTION_CALLS_DAYS=90
CEREBRO_RETENTION_CONVERSATIONS_DAYS=180
CEREBRO_BACKUP_KEEP=14

CEREBRO_LLM_PROVIDER=gemini
CEREBRO_LLM_MODEL=gemini-3.6-flash
CEREBRO_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
CEREBRO_LLM_MAX_TOKENS=2048
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
